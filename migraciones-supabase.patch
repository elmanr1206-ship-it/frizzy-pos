diff --git a/supabase/migrations/20261017000000_baseline_esquema.sql b/supabase/migrations/20261017000000_baseline_esquema.sql
new file mode 100644
index 0000000..6e0a1b2
--- /dev/null
+++ b/supabase/migrations/20261017000000_baseline_esquema.sql
@@ -0,0 +1,69 @@
+-- Baseline exportado de producción (proyecto frizzi). Tablas, restricciones, índices, RLS y políticas.
+create extension if not exists "uuid-ossp";
+create extension if not exists pgcrypto;
+create extension if not exists pg_net;
+create extension if not exists pg_cron;
+
+create table if not exists public.clientes (
+  id uuid not null default uuid_generate_v4(),
+  nombre character varying(100) not null,
+  fecha_registro timestamp with time zone default now()
+);
+create table if not exists public.productos (
+  id character varying(50) not null,
+  categoria character varying(50) not null,
+  nombre character varying(100) not null,
+  precio_actual numeric(10,2) not null,
+  disponible boolean not null default true,
+  activo boolean not null default true
+);
+create table if not exists public.pedidos (
+  id uuid not null default uuid_generate_v4(),
+  cliente_id uuid,
+  medio_pago character varying(50) not null,
+  notas text,
+  total numeric(10,2) not null,
+  creado_en timestamp with time zone default now(),
+  created_at timestamp with time zone not null default now(),
+  estado character varying(20) not null default 'completado',
+  entrega_programada_at timestamp with time zone
+);
+create table if not exists public.pedido_detalles (
+  id uuid not null default uuid_generate_v4(),
+  pedido_id uuid,
+  producto_id character varying(50),
+  cantidad integer not null,
+  precio_unitario_historico numeric(10,2) not null,
+  subtotal numeric(10,2) default ((cantidad)::numeric * precio_unitario_historico),
+  producto_nombre_historico character varying(100)
+);
+create table if not exists public.configuracion_sistema (
+  clave character varying(50) not null,
+  valor text not null,
+  updated_at timestamp with time zone not null default now()
+);
+
+alter table public.clientes add constraint clientes_pkey primary key (id);
+alter table public.clientes add constraint clientes_nombre_key unique (nombre);
+alter table public.productos add constraint productos_pkey primary key (id);
+alter table public.configuracion_sistema add constraint configuracion_sistema_pkey primary key (clave);
+alter table public.pedidos add constraint pedidos_pkey primary key (id);
+alter table public.pedidos add constraint pedidos_cliente_id_fkey foreign key (cliente_id) references public.clientes(id);
+-- NOT VALID: producción tiene filas históricas que pueden no cumplirlo; se valida con VALIDATE CONSTRAINT.
+alter table public.pedidos add constraint pedidos_estado_check
+  check (estado::text = any (array['completado','apartado','cerrado']::text[])) not valid;
+alter table public.pedido_detalles add constraint pedido_detalles_pkey primary key (id);
+alter table public.pedido_detalles add constraint pedido_detalles_cantidad_check check (cantidad > 0);
+alter table public.pedido_detalles add constraint pedido_detalles_pedido_id_fkey
+  foreign key (pedido_id) references public.pedidos(id) on delete cascade;
+alter table public.pedido_detalles add constraint pedido_detalles_pedido_producto_unique unique (pedido_id, producto_id);
+
+create index if not exists pedidos_estado_created_idx on public.pedidos using btree (estado, created_at);
+create index if not exists pedidos_created_at_idx on public.pedidos using btree (created_at);
+create index if not exists pedidos_cliente_id_idx on public.pedidos using btree (cliente_id);
+
+alter table public.clientes enable row level security;
+alter table public.productos enable row level security;
+alter table public.pedidos enable row level security;
+alter table public.pedido_detalles enable row level security;
+alter table public.configuracion_sistema enable row level security;
diff --git a/supabase/migrations/20261017000100_funciones.sql b/supabase/migrations/20261017000100_funciones.sql
new file mode 100644
index 0000000..c256c3c
--- /dev/null
+++ b/supabase/migrations/20261017000100_funciones.sql
@@ -0,0 +1,103 @@
+-- Funciones de la app (exportadas de producción).
+create or replace function public.es_admin()
+ returns boolean language sql stable
+ set search_path to 'public', 'pg_temp'
+as $$ select auth.uid() is not null $$;
+
+create or replace function public.acceso_clientes(p_pin text)
+ returns jsonb language sql stable security definer
+ set search_path to 'public'
+as $$
+    select jsonb_build_object(
+        'habilitado', coalesce((select valor from public.configuracion_sistema where clave = 'clientes_habilitados'), 'true') <> 'false',
+        'pin_ok', exists (select 1 from public.configuracion_sistema
+                          where clave = 'cliente_pin' and valor <> '' and valor = btrim(coalesce(p_pin,''))));
+$$;
+
+create or replace function public.contar_compras_cliente(p_nombre character varying)
+ returns integer language sql stable security definer
+ set search_path to 'public'
+as $$
+    select count(*)::int from public.pedidos p join public.clientes c on c.id = p.cliente_id
+    where lower(c.nombre) = lower(initcap(trim(coalesce(p_nombre,''))));
+$$;
+
+create or replace function public.estado_pedidos_cliente(p_ids uuid[])
+ returns table(id uuid, estado text, medio_pago character varying, created_at timestamp with time zone, entrega_programada_at timestamp with time zone)
+ language sql stable security definer
+ set search_path to 'public'
+as $$
+    select p.id, p.estado, p.medio_pago, p.created_at, p.entrega_programada_at
+    from public.pedidos p where p.id = any (p_ids[1:100]);
+$$;
+
+create or replace function public.actualizar_pedido_existente(p_pedido_id uuid, p_nuevo_nombre character varying, p_nuevo_pago character varying)
+ returns boolean language plpgsql security definer
+ set search_path to 'public'
+as $$
+declare v_cliente_id uuid; v_nombre varchar;
+begin
+    if not public.es_admin() then raise exception 'No autorizado' using errcode = '42501'; end if;
+    v_nombre := initcap(trim(coalesce(p_nuevo_nombre, '')));
+    if v_nombre = '' then raise exception 'Nombre inválido' using errcode = '22023'; end if;
+    insert into public.clientes (nombre) values (v_nombre)
+    on conflict (nombre) do update set nombre = excluded.nombre
+    returning id into v_cliente_id;
+    update public.pedidos set cliente_id = v_cliente_id, medio_pago = p_nuevo_pago
+    where id = p_pedido_id;
+    return found;
+end $$;
+
+create or replace function public.registrar_pedido_atomico(p_pedido_id uuid, p_cliente_nombre character varying, p_medio_pago character varying, p_total numeric, p_notas text, p_created_at timestamp with time zone, p_items jsonb, p_estado text default 'completado', p_entrega_programada_at timestamp with time zone default null)
+ returns boolean language plpgsql security definer
+ set search_path to 'public'
+as $$
+declare
+    v_cliente_id uuid; v_item jsonb; v_nombre varchar; v_actual text;
+    v_admin boolean := public.es_admin(); v_total numeric := 0; v_precio numeric; v_cant int;
+begin
+    v_nombre := initcap(trim(coalesce(p_cliente_nombre, '')));
+    if v_nombre = '' or length(v_nombre) > 120 then raise exception 'Nombre de cliente inválido' using errcode = '22023'; end if;
+    if p_estado not in ('completado','apartado') then raise exception 'Estado inválido' using errcode = '22023'; end if;
+    if p_total is null or p_total < 0 then raise exception 'Total inválido' using errcode = '22023'; end if;
+    if p_items is null or jsonb_typeof(p_items) <> 'array' or jsonb_array_length(p_items) not between 1 and 60 then
+        raise exception 'Ítems inválidos' using errcode = '22023'; end if;
+    if (select count(distinct i->>'id') from jsonb_array_elements(p_items) i) <> jsonb_array_length(p_items) then
+        raise exception 'Ítems repetidos' using errcode = '22023'; end if;
+    if not v_admin and coalesce((select valor from public.configuracion_sistema where clave = 'clientes_habilitados'), 'true') = 'false' then
+        raise exception 'Recepción de pedidos cerrada' using errcode = '22023'; end if;
+
+    select estado into v_actual from public.pedidos where id = p_pedido_id;
+    if v_actual = 'cerrado' then return true; end if;
+
+    for v_item in select * from jsonb_array_elements(p_items) loop
+        v_cant := (v_item->>'cantidad')::int;
+        if v_cant is null or v_cant < 1 or v_cant > 50 then raise exception 'Cantidad inválida' using errcode = '22023'; end if;
+        if not v_admin then
+            select precio_actual into v_precio from public.productos where id = v_item->>'id' and activo and disponible;
+            if v_precio is null then raise exception 'Producto no disponible: %', v_item->>'id' using errcode = '22023'; end if;
+            v_total := v_total + v_precio * v_cant;
+        end if;
+    end loop;
+    if not v_admin then p_total := v_total; end if;
+
+    insert into public.clientes (nombre) values (v_nombre)
+    on conflict (nombre) do update set nombre = excluded.nombre returning id into v_cliente_id;
+
+    insert into public.pedidos (id, cliente_id, medio_pago, total, notas, created_at, estado, entrega_programada_at)
+    values (p_pedido_id, v_cliente_id, p_medio_pago, p_total, coalesce(p_notas,''), coalesce(p_created_at, now()), p_estado, p_entrega_programada_at)
+    on conflict (id) do update set total = excluded.total, notas = excluded.notas, medio_pago = excluded.medio_pago,
+        estado = excluded.estado, entrega_programada_at = excluded.entrega_programada_at, created_at = excluded.created_at;
+
+    for v_item in select * from jsonb_array_elements(p_items) loop
+        v_cant := (v_item->>'cantidad')::int;
+        if v_admin then v_precio := (v_item->>'precio')::numeric;
+        else select precio_actual into v_precio from public.productos where id = v_item->>'id'; end if;
+        insert into public.pedido_detalles (pedido_id, producto_id, cantidad, precio_unitario_historico, producto_nombre_historico)
+        values (p_pedido_id, v_item->>'id', v_cant, v_precio, v_item->>'nombre')
+        on conflict (pedido_id, producto_id) do update set cantidad = excluded.cantidad,
+            precio_unitario_historico = excluded.precio_unitario_historico,
+            producto_nombre_historico = excluded.producto_nombre_historico;
+    end loop;
+    return true;
+end $$;
diff --git a/supabase/migrations/20261017000150_cerrar_jornada.sql b/supabase/migrations/20261017000150_cerrar_jornada.sql
new file mode 100644
index 0000000..b3e2ec0
--- /dev/null
+++ b/supabase/migrations/20261017000150_cerrar_jornada.sql
@@ -0,0 +1,100 @@
+-- Cierre de jornada + reporte a Telegram. El token se lee de Vault (secreto 'telegram_token').
+create or replace function public.cerrar_jornada_y_notificar(p_api_key text default null, p_solo_anteriores boolean default false)
+ returns jsonb language plpgsql security definer
+ set "TimeZone" to 'America/Bogota'
+ set search_path to 'public', 'pg_temp'
+as $$
+declare
+    v_pedidos_abiertos int := 0; v_total_ventas numeric := 0; v_total_pedidos int := 0; v_personas int := 0;
+    v_fecha_corte date; v_fecha_str text; v_pagos_txt text := ''; v_top_txt text := ''; v_mensaje text;
+    v_token text := ''; v_chat_ids_raw text := ''; v_single_chat_id text;
+begin
+    select decrypted_secret into v_token from vault.decrypted_secrets where name = 'telegram_token' limit 1;
+    if v_token is null then
+        select valor into v_token from public.configuracion_sistema where clave = 'telegram_token';
+    end if;
+    select valor into v_chat_ids_raw from public.configuracion_sistema where clave = 'telegram_chat_id';
+
+    if p_solo_anteriores or (
+        extract(hour from (now() at time zone 'America/Bogota')) = 0
+        and extract(minute from (now() at time zone 'America/Bogota')) < 15
+    ) then
+        v_fecha_corte := ((now() at time zone 'America/Bogota') - interval '1 day')::date;
+    else
+        v_fecha_corte := (now() at time zone 'America/Bogota')::date;
+    end if;
+    v_fecha_str := to_char(v_fecha_corte, 'DD/MM/YYYY');
+
+    select count(*) into v_pedidos_abiertos from public.pedidos
+    where estado = 'completado'
+      and (not p_solo_anteriores or (created_at at time zone 'America/Bogota')::date < (now() at time zone 'America/Bogota')::date);
+
+    if v_pedidos_abiertos = 0 then
+        return jsonb_build_object('cerrados', 0, 'mensaje', 'La caja ya estaba cerrada, sin ventas nuevas');
+    end if;
+
+    select count(*), coalesce(sum(total), 0), count(distinct cliente_id)
+    into v_total_pedidos, v_total_ventas, v_personas
+    from public.pedidos
+    where (estado = 'completado' and (not p_solo_anteriores or (created_at at time zone 'America/Bogota')::date <= v_fecha_corte))
+       or (estado = 'cerrado' and (created_at at time zone 'America/Bogota')::date = v_fecha_corte);
+
+    select coalesce(string_agg('• ' || medio_pago || ': <b>$' || to_char(sub_total, 'FM999G999G999') || '</b> (' || cant || ' ped.)', E'\n'), 'Sin pagos')
+    into v_pagos_txt
+    from (
+        select medio_pago, sum(total) as sub_total, count(*) as cant from public.pedidos
+        where (estado = 'completado' and (not p_solo_anteriores or (created_at at time zone 'America/Bogota')::date <= v_fecha_corte))
+           or (estado = 'cerrado' and (created_at at time zone 'America/Bogota')::date = v_fecha_corte)
+        group by medio_pago
+    ) t;
+
+    select coalesce(string_agg(pos || '. ' || nombre_prod || ': <b>' || uds || ' uds.</b>', E'\n'), 'Sin ítems')
+    into v_top_txt
+    from (
+        select row_number() over (order by sum(pd.cantidad) desc) as pos,
+               coalesce(max(pd.producto_nombre_historico), max(pr.nombre), pd.producto_id, 'Producto') as nombre_prod,
+               sum(pd.cantidad) as uds
+        from public.pedido_detalles pd
+        join public.pedidos p on p.id = pd.pedido_id
+        left join public.productos pr on pr.id = pd.producto_id
+        where (p.estado = 'completado' and (not p_solo_anteriores or (p.created_at at time zone 'America/Bogota')::date <= v_fecha_corte))
+           or (p.estado = 'cerrado' and (p.created_at at time zone 'America/Bogota')::date = v_fecha_corte)
+        group by coalesce(pd.producto_id, pd.producto_nombre_historico)
+        order by sum(pd.cantidad) desc
+        limit 5
+    ) r;
+
+    v_mensaje := '📊 <b>REPORTE DE CIERRE FRIZZY POS</b>' || E'\n' ||
+                 '📅 <b>Fecha:</b> ' || v_fecha_str || E'\n' ||
+                 '────────────────────' || E'\n' ||
+                 '🧾 <b>Pedidos (Bowls):</b> ' || v_total_pedidos || E'\n' ||
+                 '👥 <b>Personas atendidas:</b> ' || v_personas || E'\n' ||
+                 '💰 <b>Total Ventas:</b> $' || to_char(v_total_ventas, 'FM999G999G999') || E'\n' ||
+                 '────────────────────' || E'\n' ||
+                 '💳 <b>Por Medio de Pago:</b>' || E'\n' || v_pagos_txt || E'\n' ||
+                 '────────────────────' || E'\n' ||
+                 '🏆 <b>Top Más Vendidos:</b>' || E'\n' || v_top_txt;
+
+    if p_solo_anteriores then
+        update public.pedidos set estado = 'cerrado'
+        where estado = 'completado'
+          and (created_at at time zone 'America/Bogota')::date < (now() at time zone 'America/Bogota')::date;
+    else
+        update public.pedidos set estado = 'cerrado' where estado = 'completado';
+    end if;
+
+    if v_token is not null and trim(v_token) <> '' and v_chat_ids_raw is not null then
+        foreach v_single_chat_id in array string_to_array(v_chat_ids_raw, ',')
+        loop
+            v_single_chat_id := trim(v_single_chat_id);
+            if v_single_chat_id <> '' then
+                perform net.http_post(
+                    url := 'https://api.telegram.org/bot' || trim(v_token) || '/sendMessage',
+                    headers := jsonb_build_object('Content-Type', 'application/json'),
+                    body := jsonb_build_object('chat_id', v_single_chat_id, 'text', v_mensaje, 'parse_mode', 'HTML'));
+            end if;
+        end loop;
+    end if;
+
+    return jsonb_build_object('cerrados', v_pedidos_abiertos, 'total', v_total_ventas, 'resumen', v_mensaje);
+end $$;
diff --git a/supabase/migrations/20261017000200_politicas_cron.sql b/supabase/migrations/20261017000200_politicas_cron.sql
new file mode 100644
index 0000000..9d2f0ec
--- /dev/null
+++ b/supabase/migrations/20261017000200_politicas_cron.sql
@@ -0,0 +1,16 @@
+-- Políticas RLS (requieren public.es_admin() de la migración de funciones).
+create policy clientes_admin on public.clientes as permissive for all to authenticated using (es_admin()) with check (es_admin());
+create policy config_admin on public.configuracion_sistema as permissive for all to authenticated using (es_admin()) with check (es_admin());
+create policy detalles_admin on public.pedido_detalles as permissive for all to authenticated using (es_admin()) with check (es_admin());
+create policy pedidos_admin on public.pedidos as permissive for all to authenticated using (es_admin()) with check (es_admin());
+create policy menu_lectura on public.productos as permissive for select to anon, authenticated using (true);
+create policy menu_admin on public.productos as permissive for all to authenticated using (es_admin()) with check (es_admin());
+
+-- Permisos de ejecución
+revoke execute on function public.cerrar_jornada_y_notificar(text, boolean) from public, anon;
+revoke execute on function public.actualizar_pedido_existente(uuid, varchar, varchar) from public, anon;
+revoke execute on function public.rls_auto_enable() from public, anon, authenticated;
+
+-- Cierre automático 00:00 Bogotá (05:00 UTC).
+-- El token de Telegram NO va en el repo: crear con  select vault.create_secret('<TOKEN>', 'telegram_token');
+select cron.schedule('cierre-automatico-frizzy-12am', '0 5 * * *', 'SELECT public.cerrar_jornada_y_notificar();');
-- 
